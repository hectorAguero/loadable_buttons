# Pub prefers this file to .gitignore; preserve its generated/local exclusions.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
.vscode/
/pubspec.lock
/tool/dcl/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
**/pubspec_overrides.yaml

# Maintainer resources and generated coverage are not consumer artifacts.
/AGENTS.md
/CONTRIBUTING.md
/doc/*-audit.md
/doc/release-validation.md
/tool/
/coverage/
